{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "strict": true,
        "paths": {
            "@shaders": [
                "./shaders/index.ts"
            ],
            "@math/*": [
                "./math/*"
            ]
        },
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src",
        "types"
    ]
}